{% extends 'base.html.twig' %}

{% block title %}Product{% endblock %}

{% block body %}
    <body style="background-color: red;">


    <h1>Product</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ product.id }}</td>
            </tr>
            <tr>
                <th>Nombre</th>
                <td>{{ product.name }}</td>
            </tr>
            <tr>
                <th>Precio</th>
                <td>{{ product.price }}</td>
            </tr>
            <tr>
                <th>Iventario</th>
                <td>{{ product.stock }}</td>
            </tr>
            <tr>
                <th>fecha</th>
                <td>{{ product.createAt ? product.createAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_product_index') }}">back to list</a>

    <a href="{{ path('app_product_edit', {'id': product.id}) }}">edit</a>


    {{ include('product/_delete_form.html.twig') }}
    </body>
{% endblock %}
