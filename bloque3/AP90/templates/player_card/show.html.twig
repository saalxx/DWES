{% extends 'base.html.twig' %}

{% block title %}PlayerCard{% endblock %}

{% block body %}
    <h1>PlayerCard</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ player_card.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ player_card.name }}</td>
            </tr>
            <tr>
                <th>Surname</th>
                <td>{{ player_card.surname }}</td>
            </tr>
            <tr>
                <th>Age</th>
                <td>{{ player_card.age }}</td>
            </tr>
            <tr>
                <th>CurrentTeam</th>
                <td>{{ player_card.currentTeam }}</td>
            </tr>
            <tr>
                <th>GoalsScored</th>
                <td>{{ player_card.goalsScored }}</td>
            </tr>
            <tr>
                <th>CardsReceived</th>
                <td>{{ player_card.cardsReceived }}</td>
            </tr>
            <tr>
                <th>BirthDate</th>
                <td>{{ player_card.birthDate ? player_card.birthDate|date('Y-m-d') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_player_card_index') }}">back to list</a>

    <a href="{{ path('app_player_card_edit', {'id': player_card.id}) }}">edit</a>

    {{ include('player_card/_delete_form.html.twig') }}
{% endblock %}
